# ---------------------------------------------------------------------------
# For My Sheesh — LOCAL / CI TOOLING ONLY.
#
# Telegram Serverless (TGCloud 0.2.0) runs project code in a V8 isolate with no
# documented runtime environment variables and no secrets store. This file is
# NOT read by the deployed bot or Mini App. Do not expect it to configure them.
# ---------------------------------------------------------------------------

# Used by the tgcloud CLI (and the GitHub Actions workflow) to link this local
# project to its bot. Get it from:
#   BotFather -> your bot -> Serverless -> CLI Access -> Access token
# It looks like app<id>:<secret> and is NOT the ordinary Bot API token.
TGCLOUD_TOKEN=app0000000000:REPLACE_ME

# No BOT_TOKEN is required or supported here:
#   - the platform's `api` proxy is already authenticated as the bot;
#   - TGCloud derives and refreshes the webhook from tgcloud/handlers/.
# Never add a Bot API token to this project.

# Reference only, not read at runtime. The trusted owner ID is compiled into
# tgcloud/lib/config.js and must remain 8716863150.
# OWNER_TELEGRAM_ID=8716863150
