{
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json",
  // MissFrozen Gaming Bot — TGCloud app8888370613 (@missfrozen_bot).
  // Verify `npx tgcloud login`/token targets THIS app before push/migrate.
  "static": {
    "source": "web",
    "spa": true,
    "headers": [
      { "path": "/*", "set": { "Referrer-Policy": "no-referrer" } },
      // Telegram keeps the Mini App bundle in its WebView cache. Revalidate the
      // shell on every open so a shipped fix (e.g. the equipped-shinobi sync)
      // reaches players without them clearing the cache.
      { "path": "/index.html", "set": { "Cache-Control": "no-cache" } },
      { "path": "/profile.html", "set": { "Cache-Control": "no-cache" } },
      { "path": "/js/*", "set": { "Cache-Control": "no-cache" } },
      { "path": "/css/*", "set": { "Cache-Control": "no-cache" } }
    ],
    "redirects": [
      { "from": "/profile", "to": "/profile.html", "status": 302 }
    ]
  }
}
